### Variables de entorno
# Opción 1: Acceso directo al servicio (sin ngrok)
#@baseUrl = http://localhost:4040

# Opción 2: A través del túnel ngrok (reemplaza con tu URL pública de ngrok)
@baseUrl = http://unsheathe-lying-cornbread.ngrok-free.dev
@contentType = application/json

### ============================================
### 1. Crear Factura
### ============================================
POST {{baseUrl}}/v1/facturas
Content-Type: {{contentType}}


{
  "numero": "FACT-2026-001",
  "fechaEmision": "2026-04-08",
  "total": 1500.50,
  "clienteId": 983971,
  "descripcion": "Factura por servicios de consultoría"
}

### ============================================
### 2. Crear Factura (Ejemplo 2)
### ============================================
POST {{baseUrl}}/v1/facturas
Content-Type: {{contentType}}

{
  "numero": "FACT-2026-002",
  "fechaEmision": "2026-04-07",
  "total": 2300.75,
  "clienteId": 2,
  "descripcion": "Factura por desarrollo de software"
}

### ============================================
### 3. Crear Factura (Ejemplo 3 - mismo cliente)
### ============================================
POST {{baseUrl}}/v1/facturas
Content-Type: {{contentType}}

{
  "numero": "FACT-2026-003",
  "fechaEmision": "2026-04-06",
  "total": 850.00,
  "clienteId": 1,
  "descripcion": "Factura por mantenimiento"
}

### ============================================
### 4. Obtener todas las Facturas
### ============================================
GET {{baseUrl}}/v1/facturas
Accept: {{contentType}}

### ============================================
### 5. Obtener Factura por ID (ID válido)
### ============================================
GET {{baseUrl}}/v1/facturas/1
Accept: {{contentType}}

### ============================================
### 6. Obtener Factura por ID (ID 2)
### ============================================
GET {{baseUrl}}/v1/facturas/2
Accept: {{contentType}}

### ============================================
### 7. Obtener Factura por ID (No existe - error 404)
### ============================================
GET {{baseUrl}}/v1/facturas/999
Accept: {{contentType}}

### ============================================
### 8. Actualizar Factura
### ============================================
PUT {{baseUrl}}/v1/facturas/1
Content-Type: {{contentType}}

{
  "numero": "FACT-2026-001-MOD",
  "fechaEmision": "2026-04-08",
  "total": 1750.00,
  "clienteId": 1,
  "descripcion": "Factura por servicios de consultoría - Actualizada"
}

### ============================================
### 9. Actualizar Factura (cambio parcial)
### ============================================
PUT {{baseUrl}}/v1/facturas/2
Content-Type: {{contentType}}

{
  "numero": "FACT-2026-002",
  "fechaEmision": "2026-04-07",
  "total": 2500.00,
  "clienteId": 2,
  "descripcion": "Factura por desarrollo de software - Precio actualizado"
}

### ============================================
### 10. Actualizar Factura que no existe (error 404)
### ============================================
PUT {{baseUrl}}/v1/facturas/999
Content-Type: {{contentType}}

{
  "numero": "FACT-2026-999",
  "fechaEmision": "2026-04-08",
  "total": 1000.00,
  "clienteId": 1,
  "descripcion": "Esta factura no existe"
}

### ============================================
### 11. Obtener Facturas por Cliente ID (Cliente 1)
### ============================================
GET {{baseUrl}}/v1/facturas/cliente/1
Accept: {{contentType}}

### ============================================
### 12. Obtener Facturas por Cliente ID (Cliente 2)
### ============================================
GET {{baseUrl}}/v1/facturas/cliente/2
Accept: {{contentType}}

### ============================================
### 13. Obtener Facturas por Cliente ID (Cliente sin facturas)
### ============================================
GET {{baseUrl}}/v1/facturas/cliente/999
Accept: {{contentType}}

### ============================================
### 14. Eliminar Factura
### ============================================
DELETE {{baseUrl}}/v1/facturas/1

### ============================================
### 15. Eliminar Factura (ID 2)
### ============================================
DELETE {{baseUrl}}/v1/facturas/2

### ============================================
### 16. Eliminar Factura que no existe (error 404)
### ============================================
DELETE {{baseUrl}}/v1/facturas/999

### ============================================
### CASOS DE VALIDACIÓN - Errores esperados
### ============================================

### 17. Crear Factura sin número (error de validación)
POST {{baseUrl}}/v1/facturas
Content-Type: {{contentType}}

{
  "numero": "",
  "fechaEmision": "2026-04-08",
  "total": 1500.50,
  "clienteId": 1,
  "descripcion": "Factura sin número"
}

