{
  "info": {
    "name": "MS Factura API",
    "description": "Colección de pruebas para el microservicio de Facturas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Crear Factura",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"{{facturaNumero}}\",\n  \"fechaEmision\": \"{{facturaFechaEmision}}\",\n  \"total\": {{facturaTotal}},\n  \"clienteId\": {{facturaClienteId}},\n  \"descripcion\": \"{{facturaDescripcion}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    },
    {
      "name": "Obtener todas las Facturas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    },
    {
      "name": "Obtener Factura por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/{{facturaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "{{facturaId}}"]
        }
      }
    },
    {
      "name": "Actualizar Factura",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"{{facturaNumeroMod}}\",\n  \"fechaEmision\": \"{{facturaFechaEmision}}\",\n  \"total\": {{facturaTotalMod}},\n  \"clienteId\": {{facturaClienteId}},\n  \"descripcion\": \"{{facturaDescripcionMod}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/{{facturaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "{{facturaId}}"]
        }
      }
    },
    {
      "name": "Obtener Facturas por Cliente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/cliente/{{facturaClienteId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "cliente", "{{facturaClienteId}}"]
        }
      }
    },
    {
      "name": "Eliminar Factura",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/{{facturaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "{{facturaId}}"]
        }
      }
    },
    {
      "name": "Validación - Número vacío",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"{{facturaNumeroVacio}}\",\n  \"fechaEmision\": \"{{facturaFechaEmision}}\",\n  \"total\": {{facturaTotal}},\n  \"clienteId\": {{facturaClienteId}},\n  \"descripcion\": \"{{facturaDescripcionNumeroVacio}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    },
    {
      "name": "Validación - Total negativo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"{{facturaNumeroTotalNegativo}}\",\n  \"fechaEmision\": \"{{facturaFechaEmision}}\",\n  \"total\": {{facturaTotalNegativo}},\n  \"clienteId\": {{facturaClienteId}},\n  \"descripcion\": \"{{facturaDescripcionTotalNegativo}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    }
  ]
}
