{
  "info": {
    "name": "MS Factura API",
    "description": "Colección de pruebas para el microservicio de Facturas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Crear Factura",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"FACT-2026-001\",\n  \"fechaEmision\": \"2026-04-08\",\n  \"total\": 1500.50,\n  \"clienteId\": 1,\n  \"descripcion\": \"Factura por servicios de consultoría\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    },
    {
      "name": "Obtener todas las Facturas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    },
    {
      "name": "Obtener Factura por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/1",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "1"]
        }
      }
    },
    {
      "name": "Actualizar Factura",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"FACT-2026-001-MOD\",\n  \"fechaEmision\": \"2026-04-08\",\n  \"total\": 1750.00,\n  \"clienteId\": 1,\n  \"descripcion\": \"Factura por servicios de consultoría - Actualizada\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/1",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "1"]
        }
      }
    },
    {
      "name": "Obtener Facturas por Cliente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/cliente/1",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "cliente", "1"]
        }
      }
    },
    {
      "name": "Eliminar Factura",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/facturas/1",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas", "1"]
        }
      }
    },
    {
      "name": "Validación - Número vacío",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"\",\n  \"fechaEmision\": \"2026-04-08\",\n  \"total\": 1500.50,\n  \"clienteId\": 1,\n  \"descripcion\": \"Factura sin número\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    },
    {
      "name": "Validación - Total negativo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"FACT-2026-005\",\n  \"fechaEmision\": \"2026-04-08\",\n  \"total\": -100.00,\n  \"clienteId\": 1,\n  \"descripcion\": \"Factura con total negativo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "facturas"]
        }
      }
    }
  ]
}
