### Variables
@baseUrl = http://192.168.1.35:8080
@apiVersion = v1

### ========================================
### GET ALL FACTURAS
### ========================================
GET {{baseUrl}}/{{apiVersion}}/facturas
Accept: application/json

### ========================================
### GET FACTURA BY ID
### ========================================
GET {{baseUrl}}/{{apiVersion}}/facturas/1
Accept: application/json

### ========================================
### GET FACTURAS BY CLIENTE ID
### ========================================
GET {{baseUrl}}/{{apiVersion}}/facturas/cliente/100
Accept: application/json

### ========================================
### CREATE FACTURA
### ========================================
POST {{baseUrl}}/{{apiVersion}}/facturas
Content-Type: application/json

{
  "numero": "FAC-2026-001",
  "fechaEmision": "2026-04-14",
  "total": 1500.50,
  "clienteId": 100,
  "descripcion": "Factura de servicios de consultoría",
  "celular": 3001234567
}

### ========================================
### CREATE FACTURA - Example 2
### ========================================
POST {{baseUrl}}/{{apiVersion}}/facturas
Content-Type: application/json

{
  "numero": "FAC-2026-002",
  "fechaEmision": "2026-04-14",
  "total": 2750.00,
  "clienteId": 101,
  "descripcion": "Factura de desarrollo de software",
  "celular": 3109876543
}

### ========================================
### UPDATE FACTURA
### ========================================
PUT {{baseUrl}}/{{apiVersion}}/facturas/1
Content-Type: application/json

{
  "numero": "FAC-2026-001-MOD",
  "fechaEmision": "2026-04-14",
  "total": 1750.75,
  "clienteId": 100,
  "descripcion": "Factura de servicios de consultoría - Actualizada",
  "celular": 3001234567
}

### ========================================
### DELETE FACTURA
### ========================================
DELETE {{baseUrl}}/{{apiVersion}}/facturas/1
Accept: application/json

### ========================================
### TEST ERROR CASES
### ========================================

### Get non-existent factura (should return 404)
GET {{baseUrl}}/{{apiVersion}}/facturas/9999
Accept: application/json

###

### Create factura with invalid data (missing required fields)
POST {{baseUrl}}/{{apiVersion}}/facturas
Content-Type: application/json

{
  "numero": "",
  "total": -100,
  "descripcion": "Factura inválida"
}

###

### Create factura with invalid celular (should fail validation)
POST {{baseUrl}}/{{apiVersion}}/facturas
Content-Type: application/json

{
  "numero": "FAC-2026-003",
  "fechaEmision": "2026-04-14",
  "total": 1000.00,
  "clienteId": 102,
  "descripcion": "Factura con celular inválido",
  "celular": 1234567890
}

### ========================================
### SWAGGER/OPENAPI DOCS
### ========================================
GET {{baseUrl}}/v3/api-docs
Accept: application/json

###

GET {{baseUrl}}/swagger-ui/index.html
